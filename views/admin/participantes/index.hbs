<div class='d-flex justify-content-between align-items-center mb-3'>
  <h1>Participantes</h1>
  <a href='/admin/participantes/novo' class='btn btn-primary'>+ Novo
    Participante</a>
</div>

<section class='card mb-4'>
  <div class='card-body'>
    <h2 class='h5 card-title mb-3'>Importação em massa</h2>
    <form
      method='POST'
      action='/admin/participantes/importar'
      enctype='multipart/form-data'
      class='row g-3'
    >
      <div class='col-md-2'>
        <label for='evento_id' class='form-label'>ID do evento</label>
        <input
          type='number'
          min='1'
          class='form-control'
          name='evento_id'
          id='evento_id'
          required
        />
      </div>
      <div class='col-md-2'>
        <label for='origem' class='form-label'>Origem</label>
        <select class='form-select' name='origem' id='origem'>
          <option value='colado' selected>Colagem</option>
          <option value='csv'>CSV</option>
        </select>
      </div>
      <div class='col-md-8'>
        <label for='conteudo' class='form-label'>Colar planilha</label>
        <textarea
          class='form-control'
          name='conteudo'
          id='conteudo'
          rows='4'
          placeholder='nomeCompleto\temail\tinstituicao'
        ></textarea>
      </div>
      <div class='col-md-6'>
        <label for='arquivoCsv' class='form-label'>Arquivo CSV</label>
        <input
          type='file'
          class='form-control'
          name='arquivoCsv'
          id='arquivoCsv'
          accept='.csv,text/csv'
        />
      </div>
      <div class='col-12'>
        <button type='submit' class='btn btn-success'>Importar</button>
      </div>
    </form>

    {{#if resultadoImportacao}}
      <div class='alert alert-info mt-4 mb-0'>
        <strong>Importação concluída.</strong>
        {{resultadoImportacao.criados}} participantes criados,
        {{resultadoImportacao.vinculosCriados}} vínculos reaproveitados e
        {{resultadoImportacao.falhas}} falhas.
      </div>
      {{#if resultadoImportacao.errosPorLinha.length}}
        <div class='mt-3'>
          <h3 class='h6'>Erros por linha</h3>
          <ul class='list-group'>
            {{#each resultadoImportacao.errosPorLinha}}
              <li class='list-group-item'>
                <strong>Linha {{numeroLinha}}</strong>
                <div>{{nomeCompleto}} - {{email}}</div>
                <div>{{#each erros}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
              </li>
            {{/each}}
          </ul>
        </div>
      {{/if}}
    {{/if}}
  </div>
</section>

<form method='GET' action='/admin/participantes' class='mb-3 d-flex gap-2'>
  <input
    type='text'
    class='form-control'
    name='q'
    value='{{q}}'
    placeholder='Buscar por nome ou e-mail'
  />
  <button type='submit' class='btn btn-outline-secondary'>Buscar</button>
  {{#if q}}
    <a href='/admin/participantes' class='btn btn-outline-danger'>Limpar</a>
  {{/if}}
</form>

<table class='table table-bordered'>
  <thead>
    <tr>
      <th>Nome</th>
      <th>E-mail</th>
      <th>Instituição</th>
      <th>Certificados</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    {{#each participantes}}
      <tr>
        <td>{{nomeCompleto}}</td>
        <td>{{email}}</td>
        <td>{{instituicao}}</td>
        <td>{{numCertificados}}</td>
        <td>
          <a
            href='/admin/participantes/{{id}}/editar'
            class='btn btn-sm btn-warning'
          >Editar</a>
          <form
            method='POST'
            action='/admin/participantes/{{id}}/deletar'
            class='d-inline'
            onsubmit="return confirm('Remover este participante?')"
          >
            <button type='submit' class='btn btn-sm btn-danger'>Remover</button>
          </form>
        </td>
      </tr>
    {{else}}
      <tr>
        <td colspan='5' class='text-center text-muted'>Nenhum participante
          encontrado.</td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{#if arquivados.length}}
  <details class='mt-4'>
    <summary class='btn btn-link'>Participantes arquivados ({{arquivados.length}})</summary>
    <table class='table table-bordered mt-2'>
      <thead>
        <tr>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each arquivados}}
          <tr class='table-secondary'>
            <td>{{nomeCompleto}}</td>
            <td>{{email}}</td>
            <td>
              <form
                method='POST'
                action='/admin/participantes/{{id}}/restaurar'
                class='d-inline'
              >
                <button
                  type='submit'
                  class='btn btn-sm btn-success'
                >Restaurar</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </details>
{{/if}}